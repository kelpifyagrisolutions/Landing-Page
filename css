/* Agriculture animated bottom */
.why {
  position: relative;
  overflow: hidden;
  background: #12351f;
  color: #eef5e9;
}

/* Large bottom typography */
.section-heading h2 {
  font-size: clamp(2.8rem, 6vw, 5rem);
  color: #ffffff;
  line-height: 1.05;
}

.card h3 {
  font-size: 1.5rem;
}

.card p {
  font-size: 1.05rem;
  line-height: 1.7;
}

/* Animated agriculture plants */
.agri-plants {
  position: absolute;
  left: 0;
  right: 0;
  bottom: -5px;
  height: 150px;
  pointer-events: none;
  z-index: 0;
}

.plant {
  position: absolute;
  bottom: 0;
  transform-origin: bottom center;
  animation: plant-sway 4s ease-in-out infinite;
}

/* Stems */
.plant::before {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 5px;
  height: 100px;
  background: #6fa85d;
  border-radius: 999px;
  transform: translateX(-50%);
}

/* Leaves */
.plant::after {
  content: "🌿";
  position: absolute;
  left: 50%;
  bottom: 65px;
  font-size: 55px;
  transform: translateX(-50%);
  filter: saturate(0.8);
}

/* Different plants */
.plant:nth-child(1) {
  left: 4%;
  transform: scale(0.75);
  animation-delay: -1s;
}

.plant:nth-child(2) {
  left: 15%;
  transform: scale(1.05);
  animation-delay: -2s;
}

.plant:nth-child(3) {
  left: 30%;
  transform: scale(0.65);
  animation-delay: -0.5s;
}

.plant:nth-child(4) {
  right: 28%;
  transform: scale(0.9);
  animation-delay: -3s;
}

.plant:nth-child(5) {
  right: 14%;
  transform: scale(1.15);
  animation-delay: -1.5s;
}

.plant:nth-child(6) {
  right: 3%;
  transform: scale(0.7);
  animation-delay: -2.5s;
}

@keyframes plant-sway {
  0%,
  100% {
    rotate: -2deg;
  }

  50% {
    rotate: 3deg;
  }
}

/* Keep actual content above plants */
.why > * {
  position: relative;
  z-index: 2;
}
