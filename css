@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap');

:root {
  --ink: #17352c;
  --deep: #0d2d24;
  --green: #2f6f54;
  --soft-green: #e8f1e9;
  --cream: #f7f6ef;
  --white: #ffffff;
  --muted: #6d7b74;
  --line: rgba(23, 53, 44, 0.12);
  --shadow: 0 25px 70px rgba(23, 53, 44, 0.10);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  color: var(--ink);
  background: var(--cream);
  font-family: "DM Sans", Arial, sans-serif;
  overflow-x: hidden;
}

.page {
  position: relative;
  width: min(1180px, calc(100% - 40px));
  margin: 0 auto;
  z-index: 2;
}

.ambient {
  position: fixed;
  border-radius: 999px;
  filter: blur(2px);
  pointer-events: none;
  z-index: 0;
}

.ambient-one {
  width: 430px;
  height: 430px;
  top: -190px;
  right: -160px;
  background: rgba(170, 204, 178, 0.32);
}

.ambient-two {
  width: 300px;
  height: 300px;
  left: -170px;
  top: 470px;
  background: rgba(218, 228, 196, 0.35);
}

.brand {
  display: flex;
  justify-content: center;
  padding-top: 38px;
}

.brand img {
  width: 105px;
  height: 105px;
  object-fit: contain;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 10px 30px rgba(23, 53, 44, 0.08);
}

.hero {
  max-width: 830px;
  margin: 44px auto 0;
  text-align: center;
}

.eyebrow,
.section-heading > span {
  display: inline-block;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.28em;
  color: var(--green);
}

.hindi {
  margin: 14px 0 25px;
  font-size: 15px;
  color: #65756d;
}

h1 {
  margin: 0;
  font-size: clamp(52px, 8vw, 104px);
  line-height: 0.94;
  letter-spacing: -0.065em;
  font-weight: 600;
}

h1 em,
h2 em {
  font-family: "Playfair Display", Georgia, serif;
  font-weight: 500;
}

.intro {
  max-width: 560px;
  margin: 28px auto 31px;
  font-size: 16px;
  line-height: 1.75;
  color: var(--muted);
}

.notify-form {
  width: min(620px, 100%);
  margin: 0 auto;
}

.input-row {
  display: flex;
  gap: 10px;
  padding: 7px;
  background: var(--white);
  border: 1px solid var(--line);
  border-radius: 18px;
  box-shadow: var(--shadow);
}

.input-row input {
  min-width: 0;
  flex: 1;
  border: 0;
  outline: 0;
  padding: 14px 17px;
  background: transparent;
  color: var(--ink);
  font: inherit;
}

.input-row input::placeholder {
  color: #9aa59f;
}

.input-row button {
  border: 0;
  border-radius: 13px;
  padding: 0 25px;
  min-height: 48px;
  background: var(--deep);
  color: #fff;
  font: inherit;
  font-weight: 700;
  cursor: pointer;
  transition: transform .2s ease, opacity .2s ease;
}

.input-row button:hover {
  transform: translateY(-2px);
}

.input-row button:disabled {
  cursor: wait;
  opacity: .7;
  transform: none;
}

.h-captcha {
  margin: 17px auto 0;
  width: fit-content;
  min-height: 78px;
}

.response {
  min-height: 22px;
  margin-top: 10px;
  font-size: 13px;
}

.response.success {
  color: #26704d;
}

.response.error {
  color: #a03f3f;
}

.success-card {
  display: none;
  align-items: center;
  justify-content: center;
  gap: 9px;
  flex-wrap: wrap;
  margin: 10px auto 0;
  padding: 13px 18px;
  border: 1px solid rgba(47, 111, 84, .18);
  border-radius: 14px;
  background: rgba(232, 241, 233, .75);
  font-size: 13px;
}

.success-card.show {
  display: flex;
}

.success-card span {
  color: var(--muted);
}

.wave-wrap {
  width: calc(100% + 40px);
  margin-left: -20px;
  margin-top: 48px;
  height: 130px;
  overflow: hidden;
}

.wave-wrap svg {
  display: block;
  width: 100%;
  height: 100%;
}

.wave-wrap path {
  fill: #e5eee5;
}

.why {
  margin: -1px calc((100vw - min(1180px, calc(100% - 40px))) / -2) 0;
  padding: 75px max(20px, calc((100vw - min(1180px, calc(100% - 40px))) / 2)) 90px;
  background: #e5eee5;
}

.section-heading {
  text-align: center;
}

.section-heading h2 {
  margin: 12px 0 40px;
  font-size: clamp(38px, 5vw, 62px);
  line-height: 1;
  letter-spacing: -0.05em;
}

.cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.card {
  min-height: 260px;
  padding: 28px;
  background: rgba(255, 255, 255, .72);
  border: 1px solid rgba(23, 53, 44, .09);
  border-radius: 24px;
  box-shadow: 0 15px 40px rgba(23, 53, 44, .06);
  transition: transform .25s ease, box-shadow .25s ease;
}

.card:hover {
  transform: translateY(-7px);
  box-shadow: 0 22px 45px rgba(23, 53, 44, .10);
}

.icon {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  margin-bottom: 42px;
  border-radius: 50%;
  background: var(--soft-green);
  color: var(--green);
  font-size: 12px;
  font-weight: 700;
}

.card h3 {
  margin: 0 0 11px;
  font-size: 22px;
  letter-spacing: -0.03em;
}

.card p {
  margin: 0;
  color: var(--muted);
  line-height: 1.65;
  font-size: 14px;
}

footer {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding: 25px 0 32px;
  color: #7a8780;
  font-size: 12px;
}

@media (max-width: 760px) {
  .page {
    width: min(100% - 28px, 620px);
  }

  .brand {
    padding-top: 25px;
  }

  .brand img {
    width: 88px;
    height: 88px;
  }

  .hero {
    margin-top: 34px;
  }

  .hindi {
    font-size: 13px;
    margin-bottom: 21px;
  }

  h1 {
    font-size: clamp(48px, 15vw, 72px);
  }

  .intro {
    font-size: 14px;
    margin-top: 22px;
  }

  .input-row {
    flex-direction: column;
    border-radius: 16px;
  }

  .input-row button {
    width: 100%;
  }

  .why {
    padding-top: 55px;
    padding-bottom: 60px;
  }

  .cards {
    grid-template-columns: 1fr;
  }

  .card {
    min-height: auto;
  }

  .icon {
    margin-bottom: 28px;
  }

  footer {
    flex-direction: column;
    text-align: center;
  }
}
